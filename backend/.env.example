# Copy this file to backend/.env and fill in your real values.
# Do NOT commit backend/.env to Git.

# Your MongoDB Atlas/local MongoDB connection string.
# Example:
DATABASE_URL=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/YOUR_DATABASE

# A long random string used to sign login/session tokens.
JWT_SECRET=replace_this_with_a_long_random_secret
